terraform {
  required_version = ">= 1.10.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = ">= 4.0"
    }
  }

  # Bootstrap keeps its state locally (it creates the remote state bucket).
  # Keep terraform.tfstate somewhere safe, or migrate it into the bucket afterwards.
}
